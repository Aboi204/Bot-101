# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!

# Audio & Cookie Auth
COOKIE_FILE=cookies.txt
DEFAULT_VOLUME=0.5
MAX_QUEUE_SIZE=100
IDLE_TIMEOUT_SECONDS=300

# Optional: Spotify Credentials (for Spotify track/playlist metadata lookup)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Logging & Diagnostics
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
JSON_LOGS=true
