# ==============================================================================
# Bot 101 - Environment Configuration
# ==============================================================================

# Discord Bot Credentials (Required)
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
BOT_PREFIX=/
LOG_CHANNEL_NAME=bot-logs

# Cookie Authentication (Optional, for YouTube / SoundCloud / Facebook login walls)
COOKIE_FILE=cookies/cookies.txt

# Web & Health Server Port (For cloud deployment keep-alives)
PORT=8000
DEBUG_TOKEN=bot_101_secret_token

# Audio & Performance Settings
IDLE_TIMEOUT_SECONDS=300
DEFAULT_VOLUME=1.0
